{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["lib/**", "_dist/**", "src/_build/**", "tmp/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["lib/**", "_dist/**", "src/_build/**", "tmp/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
