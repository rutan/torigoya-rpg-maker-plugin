    "format": "prettier -w ./",
    "scaffold": "scaffdog generate plugin"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.9.9",
    "chokidar": "^5.0.0",
    "consola": "^3.4.2",
    "cpx2": "^8.0.2",
    "cross-env": "^10.1.0",
    "ejs": "^3.1.10",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "rollup": "^4.67.5",
    "scaffdog": "^4.1.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
