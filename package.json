{
  "name": "torigoya-rpg-maker-plugins",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build-force": "turbo build --force",
    "lint": "run-s lint:*",
    "lint:prettier": "prettier --check ./",
    "lint:turbo": "turbo lint",
